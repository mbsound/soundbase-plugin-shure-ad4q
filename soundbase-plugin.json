      "scope": "channel",
      "op": "merge"
    },
    {
      "key": "x.shure-ad4q.overloadHold",
      "scope": "channel",
      "op": "merge"
    },
    {
      "key": "x.shure-ad4q.interferenceAvoidance",
      "scope": "channel",
      "op": "merge"
    },
    {
      "key": "x.shure-ad4q.unregisteredTx",
      "scope": "channel",
      "op": "merge"
    },
    {
      "key": "x.shure-ad4q.rfPower",
      "scope": "channel",
      "op": "merge"
    },
    {
      "key": "x.shure-ad4q.encryption",
      "scope": "channel",
      "op": "merge"
    },
    {
      "key": "x.shure-ad4q.talk",
      "scope": "channel",
      "op": "merge"
    },
    {
      "key": "x.shure-ad4q.transmitter",
      "scope": "channel",
      "op": "merge"
    },
    {
      "key": "x.shure-ad4q.lastSync",
      "scope": "channel",
      "op": "merge"
    },
    {
      "key": "x.shure-ad4q.unlink",
      "scope": "channel",
      "op": "merge"
    },
    {
      "key": "x.shure-ad4q.unit",
      "scope": "device",
      "op": "replace"
    },
    {
      "key": "x.shure-ad4q.toneGen",
      "scope": "channel",
      "op": "merge"
    },
    {
      "key": "x.shure-ad4q.showLink",
      "scope": "channel",
      "op": "merge"
    },
    {
      "key": "x.shure-ad4q.status",
