{
  "manifestVersion": 1,
  "id": "shure-ad4q",
  "name": "Shure AD4Q",
  "version": "0.1.0",
  "license": "MIT",
  "platforms": [
    "darwin-arm64",
    "darwin-x64"
  ],
  "repository": "https://github.com/mbsound/soundbase-plugin-shure-ad4q",
  "maintainers": [
    {
      "name": "Matt Bell",
      "email": "matt@mbsound.org"
    }
  ],
  "contract": {
    "core": "1.4",
    "modules": {
      "ChannelMonitoring": "1.1",
      "PropertyControl": "1.0",
      "SpectrumAnalyzer": "1.2"
    }
  },
  "runtime": {
    "type": "node",
    "entrypoint": "main.js"
  },
  "deployment": [
    "managed"
  ],
  "template": {
    "name": "soundbase-plugin-template",
    "version": "1.0.15"
  },
  "products": [
    {
      "deviceTypeId": "plugin:shure-ad4q/ad4q",
      "manufacturer": {
        "id": "shure",
        "name": "Shure"
      },
      "model": {
        "id": "ad4q",
        "name": "AD4Q",
        "displayName": "Shure AD4Q"
      },
      "family": {
        "id": "axient-digital",
        "name": "Axient Digital"
      },
      "capabilities": {
        "meters": true,
        "name": true,
        "frequency": true,
        "mute": true,
        "gain": true,
        "battery": true,
        "spectrumAnalyzer": true,
        "identify": true
      },
      "traits": {
        "isReceiver": true,
        "isRackDevice": true,
        "channelCount": 4
      },
      "channelName": {
        "maxLength": 8,
        "uppercase": false,
        "allowsSpaces": true,
        "allowedChars": "^[\\x20-\\x7E]*$"
      },
      "layout": {
        "meterStyle": "led",
        "channel": [
          {
            "type": "meter",
            "bind": "meters.rf1",
            "metric": "RF_LEVEL",
            "label": "RF A"
          },
          {
            "type": "meter",
            "bind": "meters.rf2",
            "metric": "RF_LEVEL",
            "label": "RF B"
          },
          {
            "type": "meter",
            "bind": "meters.af",
            "metric": "AUDIO_LEVEL",
            "label": "Audio"
          },
          {
            "type": "value",
            "bind": "x.shure-ad4q.transmitter.model",
            "label": "Transmitter",
            "format": "text",
            "region": "cells"
          },
          {
            "type": "indicator",
            "bind": "x.shure-ad4q.status.interference",
            "label": "Interference",
            "tone": "warning",
            "on": "DETECTED",
            "region": "cells"
          },
          {
            "type": "value",
            "bind": "x.shure-ad4q.frequencyDiversity",
            "label": "Frequency Diversity",
            "format": "text"
          },
          {
            "type": "text",
            "text": "Selection: two AD transmitters, one per frequency. Combining: one ADX2FD dual-frequency transmitter. Switching to Combining unlinks every paired transmitter.",
            "tone": "info",
            "region": "detail"
          },
          {
            "type": "indicator",
            "bind": "mute",
            "label": "Mute",
            "tone": "warning"
          },
          {
            "type": "value",
            "bind": "frequency",
            "format": "frequency",
            "unit": "MHz"
          },
          {
            "type": "indicator",
            "bind": "x.shure-ad4q.toneActive",
            "label": "Tone on",
            "tone": "info",
            "region": "detail"
          },
          {
            "type": "indicator",
            "bind": "x.shure-ad4q.overloadHold",
            "label": "Overload hold",
            "tone": "info",
            "region": "detail"
          },
          {
            "type": "value",
            "bind": "x.shure-ad4q.toneFreq",
            "label": "Tone Hz",
            "unit": "Hz",
            "format": "integer",
            "region": "detail"
          },
          {
            "type": "value",
            "bind": "x.shure-ad4q.interferenceAvoidance",
            "label": "Interference avoidance",
            "format": "text",
            "region": "detail"
          },
          {
            "type": "value",
            "bind": "x.shure-ad4q.unregisteredTx",
            "label": "Unregistered TX",
            "format": "text",
            "region": "detail"
          },
          {
            "type": "value",
            "bind": "x.shure-ad4q.rfPower",
            "label": "IR preset RF power",
            "format": "text",
            "region": "detail"
          },
          {
            "type": "value",
            "bind": "x.shure-ad4q.encryption",
            "label": "Encryption",
            "format": "text",
            "region": "detail"
          },
          {
            "type": "battery",
            "bind": "battery"
          },
          {
            "type": "value",
            "bind": "x.shure-ad4q.lastSync.model",
            "label": "Last synced",
            "format": "text",
            "region": "detail"
          },
          {
            "type": "value",
            "bind": "x.shure-ad4q.transmitter.deviceId",
            "label": "Transmitter name",
            "format": "text",
            "region": "detail"
          },
          {
            "type": "value",
            "bind": "x.shure-ad4q.transmitter.powerMw",
            "label": "Transmitter power",
            "unit": "mW",
            "format": "integer",
            "region": "detail"
          },
          {
            "type": "value",
            "bind": "x.shure-ad4q.transmitter.muteMode",
            "label": "Transmitter audio",
            "format": "text",
            "region": "detail"
          },
          {
            "type": "indicator",
            "bind": "x.shure-ad4q.transmitter.talkSwitch",
            "label": "Talk switch pressed",
            "tone": "info",
            "region": "detail"
          },
          {
            "type": "indicator",
            "bind": "x.shure-ad4q.status.unregisteredTx",
            "label": "Unregistered transmitter",
            "tone": "warning",
            "on": "ERROR",
            "region": "detail"
          },
          {
            "type": "indicator",
            "bind": "x.shure-ad4q.status.encryption",
            "label": "Encryption mismatch",
            "tone": "warning",
            "on": "ERROR",
            "region": "detail"
          },
          {
            "type": "value",
            "bind": "gain",
            "label": "Gain",
            "unit": "dB",
            "format": "integer",
            "region": "detail"
          },
          {
            "type": "value",
            "bind": "x.shure-ad4q.toneLevel",
            "label": "Tone",
            "format": "text",
            "region": "detail"
          },
          {
            "type": "control",
            "propertyId": "mute"
          },
          {
            "type": "control",
            "propertyId": "gain"
          },
          {
            "type": "control",
            "propertyId": "toneLevel"
          },
          {
            "type": "control",
            "propertyId": "toneFrequency"
          },
          {
            "type": "control",
            "propertyId": "toneGenerator",
            "label": "Tone generator −30 dB"
          },
          {
            "type": "group",
            "label": "Frequency Diversity",
            "direction": "column",
            "children": [
              {
                "type": "control",
                "propertyId": "frequencyDiversity",
                "label": "Frequency Diversity"
              },
              {
                "type": "text",
                "text": "Selection: two AD transmitters, one per frequency. Combining: one ADX2FD dual-frequency transmitter. Switching to Combining unlinks every paired transmitter.",
                "tone": "info"
              }
            ]
          },
          {
            "type": "control",
            "propertyId": "overloadHold"
          },
          {
            "type": "control",
            "propertyId": "interferenceAvoidance"
          },
          {
            "type": "control",
            "propertyId": "unregisteredTransmitter"
          },
          {
            "type": "control",
            "propertyId": "transmitterPower"
          },
          {
            "type": "group",
            "label": "Talk switch: output routing",
            "direction": "column",
            "children": [
              {
                "type": "group",
                "label": "Normal",
                "direction": "row",
                "children": [
                  {
                    "type": "control",
                    "propertyId": "talkNormalXlr",
                    "label": "XLR"
                  },
                  {
                    "type": "control",
                    "propertyId": "talkNormalTrs",
                    "label": "TRS"
                  },
                  {
                    "type": "control",
                    "propertyId": "talkNormalAes3",
                    "label": "AES3"
                  },
                  {
                    "type": "control",
                    "propertyId": "talkNormalDante",
                    "label": "Dante"
                  }
                ]
              },
              {
                "type": "group",
                "label": "Pressed",
                "direction": "row",
                "children": [
                  {
                    "type": "control",
                    "propertyId": "talkPressedXlr",
                    "label": "XLR"
                  },
                  {
                    "type": "control",
                    "propertyId": "talkPressedTrs",
                    "label": "TRS"
                  },
                  {
                    "type": "control",
                    "propertyId": "talkPressedAes3",
                    "label": "AES3"
                  },
                  {
                    "type": "control",
                    "propertyId": "talkPressedDante",
                    "label": "Dante"
                  }
                ]
              }
            ]
          },
          {
            "type": "control",
            "propertyId": "unlinkTransmitter"
          }
        ],
        "device": [
          {
            "type": "value",
            "bind": "deviceName",
            "label": "Unit"
          },
          {
            "type": "value",
            "bind": "x.shure-ad4q.unit.band",
            "label": "Band",
            "format": "text"
          },
          {
            "type": "indicator",
            "bind": "connection.connected",
            "label": "Link",
            "tone": "success"
          },
          {
            "type": "group",
            "label": "HD mode",
            "direction": "column",
            "children": [
              {
                "type": "control",
                "propertyId": "highDensityMode",
                "label": "HD mode"
              },
              {
                "type": "text",
                "text": "Changing HD mode restarts the receiver (about 30 seconds off the air) and unpairs its transmitters, which must be IR-synced again.",
                "tone": "warning"
              }
            ]
          }
        ]
      }
    },
